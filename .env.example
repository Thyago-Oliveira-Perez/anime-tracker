# Copy this file to .env and fill in real values before running `docker compose up`.

POSTGRES_DB=anime_tracker
POSTGRES_USER=anime_tracker
POSTGRES_PASSWORD=change-me

# Origin the backend's CORS policy should allow (the frontend's URL).
FRONTEND_ORIGIN=http://localhost:3000

# Base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8080
